# Fevio [페비오] local development environment template.
# Copy to .env.local and fill with your own local/project values.
# Do not commit .env.local or any real secret values.

# Public browser config. Supabase anon key is intentionally public but still keep
# real project values in Vercel/Supabase env management rather than hardcoding.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Team presentation mode: no backend writes, no OAuth dependency.
# Set to 1 only on a backendless demo/presentation deployment.
NEXT_PUBLIC_FEVIO_PRESENTATION_MODE=0

# Server-only secrets. Never expose with NEXT_PUBLIC_ and never commit values.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_JWT_SECRET=

# OAuth/provider secrets are configured in Supabase dashboard for normal SLC use.
# The Next.js app does not need these for backendless presentation mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional P1 BYOK/LLM settings. User keys must live in Supabase Vault only.
OPENROUTER_DEFAULT_MODEL=

# Transactional email for reminder dispatches (N1/#52, ADR 0004 Email-only).
# Obtain from https://resend.com — free tier sufficient for SLC.
RESEND_API_KEY=

# Privacy Gate contact copy. Displayed in the v1.x deletion request notice.
PRIVACY_CONTACT_EMAIL=privacy@fevio.app
